<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1A1A1A"
    android:padding="12dp"
    android:weightSum="3"
    android:elevation="16dp"
    android:baselineAligned="false"
    android:gravity="center">

    <!-- زر 1: تسطير فريد -->
    <Button
        android:id="@+id/btn_start_typing"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:text="تسطير فريد"
        android:textColor="#121212"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/button_control_green"
        android:stateListAnimator="@null" />

    <!-- زر 2: توقف -->
    <Button
        android:id="@+id/btn_stop_typing"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:text="توقف"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/button_control_red"
        android:stateListAnimator="@null" />

    <!-- زر 3: ?123 (مصحح) -->
    <Button
        android:id="@+id/btn_switch_view"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:text="\?123"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/button_control_purple"
        android:stateListAnimator="@null" />

</LinearLayout>
