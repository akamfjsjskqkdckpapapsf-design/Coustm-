<?xml version="1.0" encoding="utf-8"?>
<!--
    التصميم الرئيسي للتطبيق (Main Activity)
    يعتمد على هوية Dark Mode مع كروت زجاجية (Glassmorphism) ونيون أخضر/بنفسجي
    يحتوي على جميع عناصر التحكم: شريط السرعة، مربع النص الضخم، أزرار الاستخراج والتسطير.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="24dp">

        <!-- ========== العنوان العلوي (Header) ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="لوحة التسطير والتفاعل الذكي"
                android:textSize="22sp"
                android:textColor="#00FF41"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="النيون"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <Switch
                    android:id="@+id/toggleNeon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#00FF41"
                    android:trackTint="#444444" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== كرت 1: ضبط الأداء والمظهر ========== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardElevation="8dp"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- صف الثيمات وحجم الخط (مؤقت) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الثيم:"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center_vertical" />

                    <Spinner
                        android:id="@+id/themeSpinner"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:entries="@array/themes_array"
                        android:popupBackground="#2A2A2A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حجم الخط"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical" />

                    <Spinner
                        android:id="@+id/fontSizeSpinner"
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:background="@drawable/spinner_background"
                        android:entries="@array/font_sizes_array"
                        android:popupBackground="#2A2A2A" />
                </LinearLayout>

                <!-- شريط السرعة -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="السرعة (ملي ثانية)"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <SeekBar
                        android:id="@+id/speedSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="#00FF41"
                        android:thumbTint="#BB86FC"
                        android:max="145" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="150"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/speedTextView"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="80 ms"
                        android:textColor="#00FF41"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- عدد الكلمات لكل سطر -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عدد الكلمات لكل سطر:"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:layout_marginEnd="12dp" />

                    <EditText
                        android:id="@+id/wordsPerLineEditText"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:inputType="number"
                        android:text="6"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/input_background"
                        android:gravity="center"
                        android:maxLength="3" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== كرت 2: مساحة إدخال النصوص الضخمة ========== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مصدر النصوص الطويلة (الصق مقالاتك هنا)"
                    android:textColor="#BB86FC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/hugeTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/input_background"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:hint="الصق النص الطويل جداً هنا (آلاف الأسطر)..."
                    android:gravity="top|start"
                    android:padding="12dp"
                    android:scrollbars="vertical"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:maxLines="1000" />

                <Button
                    android:id="@+id/extractButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="حفظ واستخراج الكلمات تلقائياً"
                    android:textColor="#121212"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_neon_green"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== كرت 3: أزرار التحكم الرئيسية ========== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center"
                android:weightSum="2">

                <Button
                    android:id="@+id/startTypingButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="▶ بدء التسطير"
                    android:textColor="#121212"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_neon_green"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/stopTypingButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="⏹ إيقاف"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_neon_red"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== ملاحظة سفلى (اختيارية) ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ اضغط '?123' في الكيبورد لعرض لوحة التحكم المصغرة"
            android:textColor="#666666"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
